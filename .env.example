# ==========================================
# VARIABLES D'ENVIRONNEMENT - LinkedIn Bot
# ==========================================
#
# INSTRUCTIONS:
# 1. Copiez ce fichier vers .env (dans le même dossier)
# 2. Remplissez avec vos vraies informations
# 3. N'oubliez PAS d'ajouter .env dans votre .gitignore !
#
# Le fichier .env ne sera JAMAIS commité sur Git
# ==========================================

# LinkedIn Credentials
LINKEDIN_EMAIL=votre.email@exemple.com
LINKEDIN_PASSWORD=VotreMotDePasseSecurise123!

# Notifications Email (optionnel)
EMAIL_NOTIF=notifications@exemple.com
EMAIL_NOTIF_PASSWORD=MotDePasseEmail456!

# AngelCo Bot (optionnel - si vous avez la version Pro)
ANGELCO_EMAIL=
ANGELCO_PASSWORD=
ANGELCO_BOT_PASSWORD=

# GlobalLogic Bot (optionnel - si vous avez la version Pro)
GLOBALLOGIC_EMAIL=
GLOBALLOGIC_PASSWORD=
GLOBALLOGIC_BOT_PASSWORD=

# Configuration additionnelle
# DEBUG=false
# HEADLESS=false
