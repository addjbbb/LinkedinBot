# =============================================================================
# VARIABLES D'ENVIRONNEMENT - LinkedIn Bot
# =============================================================================
#
# INSTRUCTIONS:
# 1. Copiez ce fichier vers .env (dans le même dossier)
# 2. Remplissez avec vos vraies informations
# 3. N'oubliez PAS d'ajouter .env dans votre .gitignore !
#
# ⚠️  IMPORTANT: Ne JAMAIS commit le fichier .env avec vos identifiants
# =============================================================================

# ============ LINKEDIN CREDENTIALS ============
LINKEDIN_EMAIL=votre.email@exemple.com
LINKEDIN_PASSWORD=VotreMotDePasseSecurise123!

# ============ OLLAMA (Optionnel - pour IA) ============
# URL de base Ollama (par défaut: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# ============ NOTIFICATIONS (Optionnel) ============
# Email pour recevoir des notifications
# NOTIFICATION_EMAIL=notifications@exemple.com

# ============ LOGGING ============
# Niveau de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
